# Environment variables used in the project

# Debug mode (true/false)
DEBUG=false

# Google Oauth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public API URL (used in axios instances)
NEXT_PUBLIC_API=

# API path prefix (used in axios instances / middleware / ws-hub). Prod
# gateway rewrites /api/v2 -> new Go backend's /api/v1; leave unset locally
# to keep hitting the backend's real /api/v1 directly.
NEXT_PUBLIC_API_PREFIX=

# Flow Agent API URL (defaults to NEXT_PUBLIC_API/agent in production; use http://127.0.0.1:8000/agent locally)
NEXT_PUBLIC_AGENT_API=

# Constructor URL
CONSTRUCTOR_URL=

# Manager URL
ADMIN_PANEL=

# NextAuth secret for authentication
NEXTAUTH_SECRET=

# Monorepo mode (set to "1" to enable monorepo mode, otherwise basePath will be "/share")
MONO=0

# Port for Docker stack deployment
PORT=3000

# Node environment (development/production/test)
# Usually set automatically by Next.js, but can be overridden
NODE_ENV=production
