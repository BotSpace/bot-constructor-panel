# Environment variables used in the project

# Debug mode (true/false)
DEBUG=false

# Public API URL (used in axios instances)
NEXT_PUBLIC_API=

# Constructor URL
CONSTRUCTOR_URL=

# Manager URL
ADMIN_PANEL=

# NextAuth secret for authentication
NEXTAUTH_SECRET=

# Monorepo mode (set to "1" to enable monorepo mode, otherwise basePath will be "/share")
MONO=

# Port for Docker stack deployment
PORT=3000

# Node environment (development/production/test)
# Usually set automatically by Next.js, but can be overridden
NODE_ENV=production
