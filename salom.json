      "position": { "x": 1700, "y": 700 },
      "data": {
        "pythonCode": "cart_items = context.get('cart', [])\nif not cart_items:\n    await bot.send_message(chat_id, 'Sizning korzinkangiz bo\\'sh. Menyu bo\\'limidan mahsulot tanlashingiz mumkin.', reply_markup={'inline_keyboard': [[{'text': '🍕 Menyu', 'callback_data': 'menu_categories'}]]})\nelse:\n    cart_text = \"<b>🛍️ Sizning korzinkangiz:</b>\\n\\n\"\n    total_price = 0\n    for i, item in enumerate(cart_items, 1):\n        cart_text += f\"{i}. {item['item']} - {item['price']} so'm\\n\"\n        total_price += item['price']\n    cart_text += f\"\\n<b>Jami: {total_price} so'm</b>\"\n    await bot.send_message(chat_id, cart_text, parse_mode='HTML', reply_markup={'inline_keyboard': [[{'text': '🗑️ Korzinkani tozalash', 'callback_data': 'clear_cart'}], [{'text': '🛒 Buyurtma berish', 'callback_data': 'proceed_to_order_from_cart'}]]})"
