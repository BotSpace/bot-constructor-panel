        "pythonCode": "user_contact = message.contact.phone_number\nuser_name = message.from_user.full_name\ncart_items = context.get('cart', [])\ntotal_price = sum(item['price'] for item in cart_items)\n\norder_details = f\"Yangi buyurtma:\\n\" \\\n                f\"Foydalanuvchi: {user_name}\\n\" \\\n                f\"Telefon: {user_contact}\\n\" \\\n                f\"Buyurtma: {', '.join([item['item'] for item in cart_items])}\\n\" \\\n                f\"Jami: {total_price} so'm\"\n\n# Adminlarga xabar yuborish\nadmin_id = 123456789 # Admin ID'sini bu yerga qo'ying!\nawait bot.send_message(admin_id, order_details)\nawait bot.send_message(chat_id, '✅ Buyurtmangiz qabul qilindi. Operatorimiz tez orada siz bilan bog\\'lanadi!', reply_markup={'remove_keyboard': True})"
