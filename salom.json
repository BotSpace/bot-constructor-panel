      "type": "CustomCodeNode",
      "position": { "x": 1300, "y": 1170 },
      "data": {
        "pythonCode": "feedback_text = message.text\nuser_id = message.from_user.id\nuser_name = message.from_user.full_name\nadmin_id = 123456789 # Admin ID'sini bu yerga qo'ying!\n\nif feedback_text == '❌ Bekor qilish':\n    await bot.send_message(chat_id, 'Fikr qoldirish bekor qilindi.', reply_markup={'remove_keyboard': True})\nelse:\n    await bot.send_message(admin_id, f'Yangi fikr:\\nFoydalanuvchi: {user_name} ({user_id})\\nFikr: {feedback_text}')\n    await bot.send_message(chat_id, '✅ Fikringiz uchun rahmat!', reply_markup={'remove_keyboard': True})"
